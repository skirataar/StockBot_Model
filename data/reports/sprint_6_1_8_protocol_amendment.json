    {
      "defect_id": "DEF-01-DSR-TRIAL-MEAN-SPECIFICATION",
      "status": "RESOLVED",
      "component": "data/reports/sprint_6_2_preregistered_protocol.json, src/utils/statistical_tooling.py, src/backtest/cross_sectional_evaluation.py",
      "summary": "Formally aligned DSR expected-maximum Sharpe benchmark with Bailey & Lopez de Prado (2014) Eq. 1: SR_star_ann = max(0.0, mu_SR) + sigma_SR * EVT(K). Enforces a zero-skill floor max(0, mu_SR) while preventing false-positive discovery for average strategies when the cohort exhibits positive drift."
    },
    {
      "defect_id": "DEF-02-CORRELATION-HEURISTIC-REMOVAL",
      "status": "RESOLVED",
      "component": "data/reports/sprint_6_2_preregistered_protocol.json, src/utils/statistical_tooling.py, src/backtest/cross_sectional_evaluation.py",
      "summary": "Completely removed unverified sqrt(1 - rho_bar) correlation heuristic. Adopted fixed K=16 discrete candidate trials as the primary binding multiple-testing hurdle. Introduced literature-grounded participation ratio effective trial count N_eff = K^2 / sum(rho_ij^2) as an audited secondary diagnostic."
    },
    {
      "defect_id": "DEF-03-STATISTICAL-FALLBACK-ELIMINATION",
      "status": "RESOLVED",
      "component": "src/utils/statistical_tooling.py, src/backtest/event_driven_engine.py, src/backtest/cross_sectional_evaluation.py",
      "summary": "Eliminated obsolete sqrt(2*ln(K)) fallback from deflated_sharpe_ratio() and event-driven engine. Single runs without cross-sectional hurdle now cleanly return status PENDING_CROSS_SECTIONAL_EVALUATION with NaN p-values. Implemented deterministic CrossSectionalEvaluator harness to orchestrate the 16 candidate validation evaluations."
    }
  ],
